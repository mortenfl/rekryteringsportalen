{
	"name": "rekryteringsportalen/rekryteringsportalen",
	"description": "WordPress theme and plugin for Rekryteringsportalen.se",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
